{
  "id": "vietmap-signs",
  "kind": "tool",
  "version": "0.5.2",
  "title": "Trợ thủ biển báo VietMap",
  "description": "Vẽ biển tốc độ lên bản đồ đồng hồ và HUD qua cluster-render: ưu tiên biển camera trước BMW (đọc từ SOME/IP xe với quyền root, chỉ đọc), nếu không có thì lấy từ app VietMap signs trên điện thoại qua Wi-Fi xe (UDP 8471); nhấp nháy mượt khi xe chạy nhanh hơn biển; không ghi gì vào xe",
  "license": "MIT",
  "mguHmi": [
    "ID7"
  ],
  "uninstallable": true,
  "requires": {
    "mgu-deploy": "0.7.11"
  },
  "files": [
    {
      "path": "vietmap-signs.js",
      "mode": "0644"
    },
    {
      "path": "camera.js",
      "mode": "0644"
    },
    {
      "path": "gen.js",
      "mode": "0644"
    },
    {
      "path": "digits.json",
      "mode": "0644"
    },
    {
      "path": "jpeg.js",
      "mode": "0644"
    },
    {
      "path": "signread.js",
      "mode": "0644"
    },
    {
      "path": "digit-templates.json",
      "mode": "0644"
    },
    {
      "path": "LICENSE",
      "mode": "0644"
    },
    {
      "path": "OFL-Inter.txt",
      "mode": "0644"
    }
  ],
  "units": [
    {
      "name": "vietmap-signs.service"
    }
  ],
  "enable": [
    {
      "unit": "vietmap-signs.service",
      "target": "oapcontroller.service"
    }
  ],
  "recmgr": [
    "vietmap-signs"
  ],
  "restart": [
    "vietmap-signs.service"
  ],
  "deactivate": [
    "node",
    "vietmap-signs.js",
    "deactivate"
  ]
}
