{
  "id": "vietmap-cluster",
  "kind": "tool",
  "version": "0.1.1",
  "title": "Trợ thủ VietMap trên đồng hồ",
  "description": "Chép màn hình giữa (VietMap Live trên Android Auto hoặc ứng dụng đang mở) sang vùng bản đồ đồng hồ và HUD qua Waze on cluster khi bật trong app VietMap trên đồng hồ; không sửa hệ thống, khi tắt hoặc gỡ sẽ trả Waze on cluster về nguyên trạng",
  "license": "MIT",
  "mguHmi": ["ID7"],
  "uninstallable": true,
  "requires": { "mgu-deploy": "0.7.11" },
  "files": [
    { "path": "vietmap-cluster.js", "mode": "0644" },
    { "path": "LICENSE", "mode": "0644" }
  ],
  "units": [
    { "name": "vietmap-cluster.service" }
  ],
  "enable": [
    { "unit": "vietmap-cluster.service", "target": "oapcontroller.service" }
  ],
  "dropins": [
    { "unit": "waze-on-cluster.service", "name": "vietmap-cluster.conf", "from": "woc-dropin.conf" }
  ],
  "recmgr": ["vietmap-cluster"],
  "restart": ["vietmap-cluster.service"],
  "deactivate": ["node", "vietmap-cluster.js", "deactivate"]
}
