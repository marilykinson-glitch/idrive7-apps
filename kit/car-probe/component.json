{
  "id": "car-probe",
  "kind": "tool",
  "version": "0.5.2",
  "title": "Car probe",
  "description": "Read-only: at install it asks the car (as root, reading only) where BMW's own speed limit can be read and prints it into the Store's log (phone page, Logs: updater), then listens for 25 minutes to what the car sends while driving; the next install prints that. Changes nothing in the car; remove it afterwards",
  "license": "MIT",
  "mguHmi": [
    "ID7"
  ],
  "optional": true,
  "uninstallable": true,
  "requires": {
    "mgu-deploy": "0.6.1"
  },
  "files": [
    {
      "path": "probe.sh",
      "mode": "0644"
    },
    {
      "path": "probe-catalog.js",
      "mode": "0644"
    },
    {
      "path": "probe-iface.js",
      "mode": "0644"
    },
    {
      "path": "probe-read.js",
      "mode": "0644"
    },
    {
      "path": "probe-listen.js",
      "mode": "0644"
    },
    {
      "path": "probe-sniff.py",
      "mode": "0644"
    },
    {
      "path": "gen.js",
      "mode": "0644"
    },
    {
      "path": "LICENSE",
      "mode": "0644"
    }
  ],
  "restart": [],
  "postInstall": [
    "probe.sh"
  ],
  "deactivate": [
    "node",
    "probe-listen.js",
    "stop"
  ]
}
