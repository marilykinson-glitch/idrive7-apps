{
  "id": "car-probe",
  "kind": "tool",
  "version": "0.6.1",
  "title": "Car probe",
  "description": "Ghi log chẩn đoán biển tốc độ BMW trong 90 giây. Đối chiếu camera với bản tin Navigation theo giờ UTC. Xem log updater trong MGU Store. Cần mgu-python.",
  "license": "MIT",
  "mguHmi": [
    "ID7"
  ],
  "optional": true,
  "uninstallable": true,
  "requires": {
    "mgu-deploy": "0.6.1"
  },
  "files": [
    {
      "path": "probe.sh",
      "mode": "0644"
    },
    {
      "path": "probe-catalog.js",
      "mode": "0644"
    },
    {
      "path": "probe-iface.js",
      "mode": "0644"
    },
    {
      "path": "probe-read.js",
      "mode": "0644"
    },
    {
      "path": "probe-listen.js",
      "mode": "0644"
    },
    {
      "path": "probe-sniff.py",
      "mode": "0644"
    },
    {
      "path": "probe-blinker.js",
      "mode": "0644"
    },
    {
      "path": "gen.js",
      "mode": "0644"
    },
    {
      "path": "LICENSE",
      "mode": "0644"
    }
  ],
  "restart": [],
  "postInstall": [
    "probe.sh"
  ],
  "deactivate": [
    "node",
    "probe-listen.js",
    "stop"
  ]
}
