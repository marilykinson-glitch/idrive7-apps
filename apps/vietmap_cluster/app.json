    "de.bmw.infotainment.vehicle.Vehicle2": { "statusCarSpeed2": "rs" }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "VietMap trên đồng hồ",
      "buttons": [
        ["BTN_ON", "Bật"],
        ["BTN_OFF", "Tắt"],
        ["BTN_VIEW", "Chế độ xem tiếp"],
        ["BTN_SETTINGS", "Cài đặt"]
      ]
    }
  ],
  "settings": [
    {"key": "mode", "label": "Màn giữa lên đồng hồ", "type": "choice", "default": "off",
     "options": [["off", "Tắt · bản đồ đồng hồ của điện thoại"], ["on", "Bật · bản đồ trên màn giữa"]]},
    {"key": "view", "label": "Chế độ xem", "type": "choice", "default": "fit",
     "options": [["fit", "Toàn bản đồ"], ["zoom1", "Phóng to 1.25×"], ["zoom2", "Phóng to 1.5×"]]},
    {"key": "theme", "label": "Màu giao diện", "type": "choice", "default": "m_tricolour",
