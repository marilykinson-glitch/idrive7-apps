    {"key": "side", "label": "Vị trí biển", "type": "choice", "default": "right",
     "options": [["right", "Trên, bên phải"], ["left", "Trên, bên trái"]]},
    {"key": "hudSide", "label": "Vị trí biển trên HUD", "type": "choice", "default": "left",
     "options": [["left", "Trên, bên trái"], ["right", "Trên, bên phải"]]},
    {"key": "size", "label": "Cỡ biển", "type": "choice", "default": "medium",
     "options": [["small", "Nhỏ"], ["medium", "Vừa"], ["large", "Lớn"]]},
    {"key": "camera", "label": "Ưu tiên biển camera BMW", "type": "choice", "default": "on",
     "options": [["on", "Bật"], ["off", "Tắt: chỉ biển VietMap"]]},
    {"key": "screen", "label": "Đọc biển trên màn giữa (CarPlay) - thử nghiệm, có thể đọc sai", "type": "choice", "default": "off",
     "options": [["off", "Tắt"], ["on", "Bật"]]},
    {"key": "warn", "label": "Cảnh báo khi chạy nhanh hơn biển", "type": "choice", "default": "5",
