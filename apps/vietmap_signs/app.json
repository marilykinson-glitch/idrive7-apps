    {"key": "theme", "label": "Màu giao diện", "type": "choice", "default": "m_tricolour",
     "options": [["m_red", "M Red"], ["m_tricolour", "M Tricolour"], ["ice", "Ice White"], ["amber", "Night Amber"]]},
    {"key": "layout", "label": "Bố cục màn hình", "type": "choice", "default": "full",
     "options": [["full", "Toàn màn hình"], ["standard", "Tiêu chuẩn"]]},
    {"key": "renderer", "label": "Bộ vẽ", "type": "choice", "default": "auto",
     "options": [["auto", "GPU 60 fps (mặc định)"], ["software", "Phần mềm"]]}
