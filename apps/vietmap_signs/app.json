{
  "id": "vietmap_signs",
  "title": "Biển báo VietMap",
  "description": "Hiện biển tốc độ từ camera trước BMW, hoặc từ VietMap Live, lên đồng hồ và HUD. Nhận biển từ màn giữa (CarPlay) hoặc từ app VietMap signs trên điện thoại qua Wi-Fi xe. Chớp khi xe chạy nhanh hơn biển. Trợ thủ vietmap-signs tự cài kèm; cần có Waze on cluster và cluster-render.",
  "version": "0.5.0",
  "vendor": "custom",
  "loggingId": "OAA5",
  "iconGlyph": "flag",
  "signals": {
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "_optional": "the car's speed; no warning above the sign then",
      "statusCarSpeed2": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Biển báo VietMap",
      "buttons": [
        ["BTN_ON", "Bật"],
        ["BTN_OFF", "Tắt"],
        ["BTN_SHOW", "Hiện trên"],
        ["BTN_SETTINGS", "Cài đặt"]
      ]
    }
  ],
  "settings": [
    {"key": "mode", "label": "Biển tốc độ trên đồng hồ", "type": "choice", "default": "on",
     "options": [["on", "Bật"], ["off", "Tắt"]]},
    {"key": "show", "label": "Hiện trên", "type": "choice", "default": "both",
