{
  "id": "mgu_diagnostics",
  "title": "MGU Diagnostics",
  "description": "Scan BMW control units, review vehicle messages, and save a report before clearing faults",
  "version": "0.1.9",
  "vendor": "custom",
  "loggingId": "OA95",
  "iconGlyph": "engine",
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.checkcontrol.CheckControlMaster": {
      "basicList": "rs"
    },
    "de.bmw.infotainment.KombiInterface_2": {
      "ccList": "rs",
      "newCCMessage": "rs"
    },
    "de.bmw.infotainment.KombiIF": {
      "statusShowTimeDate": "rs",
      "statusTimeDate": "rs",
      "statusRangeTankStatus": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "statusBattery2": "rs",
      "statusEngineTemperature": "rs"
    },
    "de.bmw.infrastructure.VehicleCondition": {
      "VehicleCondition": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "MGU Diagnostics",
      "buttons": [
        [
          "BTN_SCAN",
          "Scan now"
        ],
        [
          "BTN_CLEAR",
          "Clear all"
        ],
        [
          "BTN_PAGE",
          "Next page"
        ],
        [
          "BTN_REPORT",
          "Save report"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "scope",
      "label": "Faults to read",
      "type": "choice",
      "default": "current",
      "options": [
        [
          "current",
          "Current"
        ],
        [
          "all",
          "Incl. history"
        ]
      ]
    },
    {
      "key": "info",
      "label": "Also read info memory",
      "type": "bool",
      "default": false
    },
    {
      "key": "autoScan",
      "label": "Scan when opened",
      "type": "bool",
      "default": true
    },
    {
      "key": "theme",
      "label": "Colour theme",
      "type": "choice",
      "default": "m_tricolour",
      "options": [
        [
          "m_red",
          "M Red"
        ],
        [
          "m_tricolour",
          "M Tricolour"
        ],
        [
          "ice",
          "Ice White"
        ],
        [
          "amber",
          "Night Amber"
        ]
      ]
    },
    {
      "key": "layout",
      "label": "Screen layout",
      "type": "choice",
      "default": "full",
      "options": [
        [
          "full",
          "Full screen"
        ],
        [
          "standard",
          "Standard"
        ]
      ]
    },
    {
      "key": "renderer",
      "label": "Renderer",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "GPU 60 fps (default)"
        ],
        [
          "software",
          "Software"
        ]
      ]
    },
    {
      "key": "demo",
      "label": "Demo data",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "Automatic"
        ],
        [
          "on",
          "Always on"
        ],
        [
          "off",
          "Off"
        ]
      ]
    }
  ]
}
